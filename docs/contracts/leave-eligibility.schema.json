{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vacate:leave-eligibility:v1",
  "title": "Own leave eligibility response — proposed v1",
  "description": "Synthetic current-context response boundary; not an implemented API or approved legal policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "companyId", "employeeId", "countryCode", "asOf", "evaluationId", "policyVersion", "decisions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "companyId": {"type": "string", "minLength": 1},
    "employeeId": {"type": "string", "minLength": 1},
    "countryCode": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "asOf": {"type": "string", "format": "date"},
    "evaluationId": {"type": "string", "minLength": 1},
    "policyVersion": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeId", "status", "reasonCode", "reason", "policyVersion"],
      "properties": {
        "typeId": {"type": "string", "minLength": 1},
        "status": {"enum": ["eligible", "not-eligible", "to-confirm"]},
        "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 240},
        "policyVersion": {"type": "string", "minLength": 1}
      }
    }
  }
}
