{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/config.json", "/*.{js,css,json,ico,png,svg,woff,woff2}"]
  },
  "routes": [
    { "route": "/", "redirect": "/design-preview/index.html", "statusCode": 302 },
    { "route": "/design-preview", "redirect": "/design-preview/index.html", "statusCode": 302 },
    { "route": "/design-preview/index.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/design-preview/revision.json", "headers": { "Cache-Control": "no-store" } },
    { "route": "/config.json", "headers": { "Cache-Control": "no-store" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-store" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
