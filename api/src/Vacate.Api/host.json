{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Information"
    },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true },
      "httpAutoCollectionOptions": { "enableHttpTriggerExtendedInfoCollection": false }
    }
  },
  "extensions": {
    "http": { "routePrefix": "api" }
  }
}
