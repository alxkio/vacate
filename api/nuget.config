<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear user-level feeds so restores use only nuget.org and central package management can map sources. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
